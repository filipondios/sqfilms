<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/static/css/common.css">
    <link rel="stylesheet" href="/static/css/index.css">
    <link rel="icon" href="/static/img/icon.svg" type="image/svg+xml">
    <script src="/static/js/delete-review-confirm.js" defer></script>
</head>
<body>
    <header class="page-header">
        <div class="header-nav-left">
            <a href="/tosee" class="header-nav-btn" title="Open to-see list">
                <img src="/static/img/checklist.svg" alt="" class="nav-icon">
                <span>To See</span>
            </a>
        </div>
        <div class="header-top">
            <h1>{{ title }}</h1>
        </div>
        <div class="search-bar">
            <input type="text" id="title-input" placeholder="Filter by title" value="{{ title_filter or '' }}" oninput="handleTitleSearch()">
            <a href="/new" class="add-button" title="Add new review">+</a>
        </div>
    </header>
    <div class="main-content">
        <div id="sort-container" class="sort-container {% if not reviews %}hidden{% endif %}">
            <div class="filters-wrapper">
                <select id="type-select" class="filter-select" onchange="handleFiltersChange()">
                    <option value="all" {% if type_filter == "films" or type_filter == "series" %}{% else %}selected{% endif %}>All</option>
                    <option value="films" {% if type_filter == "films" %}selected{% endif %}>Only Films</option>
                    <option value="series" {% if type_filter == "series" %}selected{% endif %}>Only Series</option>
                </select>
                <select id="sort-select" class="filter-select" onchange="handleFiltersChange()">
                    <option value="insert_oldest" {% if sort_by == "insert_oldest" %}selected{% endif %}>By insertion (oldest)</option>
                    <option value="insert_newest" {% if sort_by not in ['insert_oldest'] %}selected{% endif %}>By insertion (newest)</option>
                </select>
            </div>
        </div>
        <ol class="reviews-grid">
        {% for r in reviews %}
        <li class="review-card">
            <div class="poster-wrap">
                {% if r.imdb_link %}
                <a class="poster-link" href="{{ r.imdb_url or ('https://www.imdb.com/title/tt' ~ r.imdb_link) }}" target="_blank" rel="noopener noreferrer" aria-label="Open IMDb for {{ r.title }}">
                {% endif %}
                    <img class="poster" src="{{ r.poster_full_url or r.poster_url or '/static/img/poster-placeholder.svg' }}"
                        alt="Poster of {{ r.title }}" loading="lazy"
                        onerror="this.onerror=null;this.src='/static/img/poster-placeholder.svg';">
                {% if r.imdb_link %}</a>{% endif %}
                <div class="poster-top-left">
                    {% if r.season is none %}
                        <span class="tag film overlay-tag">Film</span>
                    {% else %}
                        <div class="overlay-group series-stack">
                            <span class="tag series overlay-tag">Series</span>
                            <span class="tag season overlay-tag season-inline">Season {{ r.season }}</span>
                        </div>
                    {% endif %}
                </div>
                <span class="rating-badge">
                    {{ r.note }}
                    <img src="/static/img/star.svg" alt="" class="star">
                </span>
            </div>
            <div class="card-body">
                <div class="title-tags">
                    <h3 class="review-title">{{ r.title }}</h3>
                </div>
                <div class="review-meta">
                    <span class="date">
                        <img src="/static/img/calendar.svg" alt="Date icon" class="icon-date">
                        {{ r.date | default("-/-/-") }}
                    </span>
                </div>
                <div class="review-actions">
                    <a href="/edit/{{ r.id }}" class="btn-action edit-btn" title="Edit">
                        <img src="/static/img/edit.svg" alt="Edit icon">
                        Edit
                    </a>
                    <form method="POST" action="/delete/{{ r.id }}" class="inline-form delete-form">
                        <button type="submit" class="btn-action delete-btn" title="Delete">
                            <img src="/static/img/delete.svg" alt="Delete icon">
                            Delete
                        </button>
                    </form>
                </div>
            </div>
        </li>
        {% else %}
        <div class="empty-state">
            <img src="/static/img/warning.svg" aria-hidden="true" class="empty-icon"/>
            <p class="no-results">No reviews found</p>
        </div>
        {% endfor %}
        </ol>
    </div>

    <footer class="results-summary">
        <p>{{ films }} Films, {{ series }} Series - {{ total }} Reviews total</p>
    </footer>

    <script>
        let titleSearchTimeout;

        function renderReviews(reviews) {
            const reviewsList = document.querySelector('ol');
            const sortContainer = document.getElementById('sort-container');
            sortContainer.classList.toggle('hidden', reviews.length === 0);

            if (reviews.length === 0) {
                reviewsList.innerHTML = `
                    <div class="empty-state">
                        <img src="/static/img/warning.svg" aria-hidden="true" class="empty-icon"/>
                        <p class="no-results">No reviews found</p>
                    </div>
                `;
                updateSummary(0, 0, 0);
                return;
            }

            let html = '';
            let filmCount = 0;
            let seriesCount = 0;

            reviews.forEach(r => {
                const isFilm = r.season === null;
                if (isFilm) filmCount++;
                else seriesCount++;

                const posterSrc = r.poster_full_url || r.poster_url || '/static/img/poster-placeholder.svg';
                const posterLink = r.imdb_link
                    ? `<a class="poster-link" href="${r.imdb_url || 'https://www.imdb.com/title/tt' + r.imdb_link}" target="_blank" rel="noopener noreferrer" aria-label="Open IMDb for ${r.title}">`
                    : '';
                const posterLinkClose = r.imdb_link ? '</a>' : '';
                const typeOverlay = isFilm
                    ? `<span class="tag film overlay-tag">Film</span>`
                    : `<div class="overlay-group series-stack"><span class="tag series overlay-tag">Series</span><span class="tag season overlay-tag season-inline">Season ${r.season}</span></div>`;

                html += `
                    <li class="review-card">
                        <div class="poster-wrap">
                            ${posterLink}
                            <img class="poster" src="${posterSrc}" alt="Poster of ${r.title}" loading="lazy"
                                onerror="this.onerror=null;this.src='/static/img/poster-placeholder.svg';">
                            ${posterLinkClose}
                            <div class="poster-top-left">
                                ${typeOverlay}
                            </div>
                            <span class="rating-badge">
                                ${r.note}
                                <img src="/static/img/star.svg" alt="" class="star">
                            </span>
                        </div>
                        <div class="card-body">
                            <div class="title-tags">
                                <h3 class="review-title">${r.title}</h3>
                            </div>
                            <div class="review-meta">
                                <span class="date">
                                    <img src="/static/img/calendar.svg" alt="Date icon" class="icon-date">
                                    ${r.date || '-/-/-'}
                                </span>
                            </div>
                            <div class="review-actions">
                                <a href="/edit/${r.id}" class="btn-action edit-btn" title="Edit">
                                    <img src="/static/img/edit.svg" alt="Edit icon">
                                    Edit
                                </a>
                                <form method="POST" action="/delete/${r.id}" class="inline-form delete-form">
                                    <button type="submit" class="btn-action delete-btn" title="Delete">
                                        <img src="/static/img/delete.svg" alt="Delete icon">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </li>
                `;
            });

            reviewsList.innerHTML = html;
            updateSummary(filmCount, seriesCount, reviews.length);
            attachDeleteFormListeners();
        }

        function updateSummary(films, series, total) {
            const summary = document.querySelector('.results-summary p');
            summary.textContent = `${films} Films, ${series} Series - ${total} Reviews total`;
        }

        function attachDeleteFormListeners() {
            const deleteForms = document.querySelectorAll('.delete-form');
            deleteForms.forEach(form => {
                form.addEventListener('submit', function(e) {
                    if (!confirm('¿Estás seguro de que deseas eliminar esta reseña?')) {
                        e.preventDefault();
                    }
                });
            });
        }

        function fetchReviews() {
            const titleInput = document.getElementById('title-input');
            const typeSelect = document.getElementById('type-select');
            const sortSelect = document.getElementById('sort-select');

            const params = new URLSearchParams();
            if (titleInput.value) params.append('title', titleInput.value);
            if (typeSelect.value !== 'all') params.append('type_filter', typeSelect.value);
            if (sortSelect.value !== 'insert_newest') params.append('sort_by', sortSelect.value);

            const queryString = params.toString() ? '?' + params.toString() : '';
            
            fetch('/reviews' + queryString)
                .then(response => response.json())
                .then(reviews => {
                    renderReviews(reviews);
                    updateURL(titleInput.value, typeSelect.value, sortSelect.value);
                })
                .catch(error => console.error('Error fetching reviews:', error));
        }

        function updateURL(title, typeFilter, sortBy) {
            const params = new URLSearchParams();
            if (title) params.append('title', title);
            if (typeFilter && typeFilter !== 'all') params.append('type_filter', typeFilter);
            if (sortBy && sortBy !== 'insert_newest') params.append('sort_by', sortBy);
            
            const queryString = params.toString() ? '?' + params.toString() : '';
            window.history.replaceState({}, '', queryString || '/');
        }

        function handleTitleSearch() {
            clearTimeout(titleSearchTimeout);
            titleSearchTimeout = setTimeout(() => {
                fetchReviews();
            }, 500);
        }

        function handleFiltersChange() {
            fetchReviews();
        }

        attachDeleteFormListeners();
    </script>
</body>
</html>